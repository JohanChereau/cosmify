{
  "name": "cosmify",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-dist.mjs",
    "ensure:dist": "node scripts/ensure-dist.mjs",
    "dev": "vite --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "pnpm ensure:dist && tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:all": "pnpm check && pnpm check:rust",
    "check:version": "node scripts/check-version.mjs",
    "release:check": "pnpm check:version && pnpm format:check && pnpm check && pnpm check:rust && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^1.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "description": "A local-first desktop manager for Minecraft Bedrock Persona cosmetics.",
  "license": "MIT",
  "keywords": [
    "minecraft",
    "bedrock",
    "persona",
    "cosmetics",
    "tauri",
    "rust"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.34.5 <11"
  }
}
